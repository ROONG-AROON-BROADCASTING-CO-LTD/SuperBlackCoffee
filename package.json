{
  "name": "superblackcoffee",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:go": "find apps/api -name '*.go' -type f -print0 | xargs -0 gofmt -w",
    "clean": "rimraf apps/*/dist apps/*/.next",
    "dev:website": "pnpm --filter @stackbuild/website dev",
    "build:website": "pnpm --filter @stackbuild/website build",
    "lint:website": "pnpm --filter @stackbuild/website lint",
    "dev:api": "cd apps/api && set -a && . ./.env && set +a && go run ./cmd/api",
    "dev:test-db": "docker compose --profile test up -d database-test",
    "test:api": "cd apps/api && go test ./...",
    "test:management": "vitest run packages/management/src/pages/__tests__",
    "test:franchise": "vitest run apps/franchise/src",
    "test:admin": "vitest run apps/admin/src",
    "test:frontend": "vitest run",
    "test:api:integration": "cd apps/api && TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/test_app go test -p 1 ./...",
    "build:api": "cd apps/api && go build ./cmd/api",
    "dev:admin": "pnpm --filter @stackbuild/admin dev",
    "dev:franchise": "pnpm --filter @stackbuild/franchise dev",
    "dev:attendance": "pnpm --filter @stackbuild/attendance dev",
    "build:admin": "pnpm --filter @stackbuild/admin build",
    "build:franchise": "pnpm --filter @stackbuild/franchise build",
    "build:attendance": "pnpm --filter @stackbuild/attendance build",
    "lint:admin": "pnpm --filter @stackbuild/admin lint",
    "lint:franchise": "pnpm --filter @stackbuild/franchise lint",
    "lint:attendance": "pnpm --filter @stackbuild/attendance lint",
    "dev": "concurrently \"pnpm run dev:website\" \"pnpm run dev:api\" \"pnpm run dev:admin\" \"pnpm run dev:franchise\" \"pnpm run dev:attendance\"",
    "build": "pnpm run build:website && cd apps/api && go build ./cmd/api && pnpm run build:admin && pnpm run build:franchise && pnpm run build:attendance",
    "lint": "pnpm run lint:website && pnpm run lint:admin && pnpm run lint:franchise"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "concurrently": "latest",
    "jsdom": "^30.0.1",
    "prettier": "latest",
    "rimraf": "latest",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
