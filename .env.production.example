# Public addresses. Vite and Next.js values are compiled into their frontend builds.
VITE_API_URL=https://api.superblackcoffee.co.th/api/v1
NEXT_PUBLIC_API_URL=https://api.superblackcoffee.co.th/api/v1
NEXT_PUBLIC_SITE_URL=https://superblackcoffee.co.th
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# API runtime secrets. Keep the real values in the cloud provider's secret store.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=rediss://:PASSWORD@HOST:6379/0
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://superblackcoffee.co.th,https://admin.superblackcoffee.co.th,https://franchise.superblackcoffee.co.th,https://attendance.superblackcoffee.co.th,https://stock.superblackcoffee.co.th
