{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@stackbuild/ui": ["../../packages/ui/src/index.tsx"],
      "@stackbuild/management": ["../../packages/management/src/index.ts"],
      "@stackbuild/management/pages/attendance": [
        "../../packages/management/src/pages/AttendanceManagementPage.tsx"
      ],
      "@stackbuild/management/pages/leave-requests": [
        "../../packages/management/src/pages/LeaveRequestsManagementPage.tsx"
      ],
      "@stackbuild/management/pages/promotions": [
        "../../packages/management/src/pages/PromotionsManagementPage.tsx"
      ],
      "@stackbuild/types": ["../../packages/types/src/index.ts"]
    }
  },
  "include": [
    "src",
    "../../packages/ui/src",
    "../../packages/types/src",
    "../../packages/management/src"
  ]
}
