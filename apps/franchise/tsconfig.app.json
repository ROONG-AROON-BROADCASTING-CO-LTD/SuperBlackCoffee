{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@stackbuild/ui": ["../../packages/ui/src/index.tsx"],
      "@stackbuild/management": ["../../packages/management/src/index.ts"],
      "@stackbuild/management/pages/employees": [
        "../../packages/management/src/pages/EmployeesManagementPage.tsx"
      ],
      "@stackbuild/management/pages/ingredients": [
        "../../packages/management/src/pages/IngredientsManagementPage.tsx"
      ],
      "@stackbuild/management/pages/products": [
        "../../packages/management/src/pages/ProductsManagementPage.tsx"
      ],
      "@stackbuild/management/pages/stock": [
        "../../packages/management/src/pages/StockManagementPage.tsx"
      ],
      "@stackbuild/management/pages/leave-requests": [
        "../../packages/management/src/pages/LeaveRequestsManagementPage.tsx"
      ],
      "@stackbuild/management/skeletons/employees": [
        "../../packages/management/src/components/skeletons/EmployeesSkeleton.tsx"
      ],
      "@stackbuild/management/skeletons/ingredients": [
        "../../packages/management/src/components/skeletons/IngredientsSkeleton.tsx"
      ],
      "@stackbuild/management/skeletons/products": [
        "../../packages/management/src/components/skeletons/ProductsSkeleton.tsx"
      ],
      "@stackbuild/management/skeletons/stock": [
        "../../packages/management/src/components/skeletons/StockSkeleton.tsx"
      ]
    }
  },
  "include": [
    "src",
    "../../packages/ui/src",
    "../../packages/management/src",
    "../../packages/types/src"
  ]
}
