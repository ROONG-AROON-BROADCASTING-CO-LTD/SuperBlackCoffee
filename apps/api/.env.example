API_PORT=8080
APP_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=superblackcoffee-assets
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# Production example:
# APP_ENV=production
# JWT_SECRET=use-a-long-random-secret
# CORS_ORIGINS=https://admin.example.com,https://pos.example.com
